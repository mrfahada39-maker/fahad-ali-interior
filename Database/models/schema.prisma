generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                   @id @default(cuid())
  name                String?
  email               String                   @unique
  password            String?
  phone               String?
  bio                 String?
  avatar              String?
  language            String                   @default("en")
  darkMode            Boolean                  @default(false)
  emailNotif          Boolean                  @default(true)
  pushNotif           Boolean                  @default(true)
  orderNotif          Boolean                  @default(true)
  promoNotif          Boolean                  @default(false)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  emailVerified       DateTime?
  role                UserRole                 @default(USER)
  deletedAt           DateTime?
  loginAttempts       Int                      @default(0)
  lockedUntil         DateTime?
  totpSecret          String?
  totpEnabled         Boolean                  @default(false)
  backupCodes         String[]                 @default([])
  isPremiumMember     Boolean                  @default(false)
  premiumExpiresAt    DateTime?
  premiumPlan         String?
  segment             CustomerSegment?
  loyaltyTier         LoyaltyTier              @default(BRONZE)
  loyaltyPoints       Int                      @default(0)
  tags                String[]                 @default([])
  lastLoginAt         DateTime?
  lastActivityAt      DateTime?
  dataRetentionDate   DateTime?
  updatedBy           String?
  addresses           Address[]
  auditLogs           AuditLog[]
  verificationTokens  EmailVerificationToken[]
  customerNotes       CustomerNote[]
  authoredNotes       CustomerNote[]    @relation("NoteAuthor")
  loginHistory        LoginHistory[]
  inquiries           Inquiry[]
  messages            Message[]
  notifications       Notification[]
  orders              Order[]
  passwordResetTokens PasswordResetToken[]
  pushSubscriptions   PushSubscription[]
  refreshTokens       RefreshToken[]
  sessions            Session[]
  reviews             Review[]
  wishlistItems       WishlistItem[]
  aiConversations     AiConversation[]
  chatSessions        ChatSession[]


  @@index([deletedAt])
  @@index([createdAt])
  @@index([lockedUntil])
  @@index([email])
  @@index([segment])
  @@index([loyaltyTier])
  @@index([loyaltyPoints])
  @@index([role, deletedAt])
  @@index([lastLoginAt, role])
  @@index([segment, loyaltyTier])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  jti       String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
}

model Session {
  id            String    @id @default(cuid())
  userId        String
  jti           String    @unique
  deviceName    String?
  deviceType    String?
  browser       String?
  os            String?
  ip            String?
  location      String?
  isCurrent     Boolean   @default(false)
  lastActiveAt  DateTime  @default(now())
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jti])
  @@index([expiresAt])
  @@index([userId, lastActiveAt])
  @@index([userId, isCurrent])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@index([action, createdAt])
  @@index([entity, entityId])
  @@index([action, entity, createdAt])
  @@index([userId, action, createdAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Product {
  id            String         @id @default(cuid())
  name          String
  description   String?
  price         Decimal        @db.Decimal(10, 2)
  category      String
  image         String
  material      String?
  dimensions    String?
  stockCount    Int            @default(0)
  isPremium     Boolean        @default(false)
  specs         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  images        String[]
  createdBy     String?
  categoryId    String?
  categoryRel   Category?      @relation(fields: [categoryId], references: [id])
  orderItems    OrderItem[]
  reviews       Review[]
  wishlistItems WishlistItem[]

  @@index([category])
  @@index([categoryId])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([createdBy])
  @@index([category, deletedAt])
  @@index([category, createdAt, price])
  @@index([isPremium, deletedAt])
  @@index([price, deletedAt])
}

model Order {
  id                String          @id @default(cuid())
  userId            String
  discount          Decimal         @default(0) @db.Decimal(10, 2)
  gst               Decimal         @db.Decimal(10, 2)
  totalAmount       Decimal         @db.Decimal(10, 2)
  paymentScreenshot String?
  couponCode        String?
  shippingName      String?
  shippingPhone     String?
  shippingEmail     String?
  shippingAddress   String?
  shippingCity      String?
  shippingProvince  String?
  shippingNotes     String?
  trackingNumber    String?
  paymentGatewayRef String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  orderFingerprint  String?         @unique
  subtotal          Decimal         @db.Decimal(10, 2)
  status            OrderStatus     @default(PENDING)
  paymentStatus     PaymentStatus   @default(PENDING)
  paymentMethod     PaymentMethod?
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items             OrderItem[]
  tracking          OrderTracking[]

  @@index([userId, createdAt])
  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([userId, status])
  @@index([userId, paymentStatus])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([couponCode])
}

model CheckoutLock {
  userId    String   @id
  lockedAt  DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  name      String
  price     Decimal @db.Decimal(10, 2)
  quantity  Int     @default(1)
  image     String?
  size      String?
  color     String?
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model OrderTracking {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  location  String?
  note      String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

model Review {
  id           String       @id @default(cuid())
  productId    String
  userId       String
  customerName String?
  rating       Int
  comment      String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?
  status       ReviewStatus @default(PENDING)
  updatedBy    String?
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
  @@index([status])
  @@index([productId, status])
  @@index([userId, createdAt])
  @@index([productId, createdAt])
  @@index([deletedAt])
}

model Message {
  id        String   @id @default(cuid())
  userId    String
  text      String
  sender    String   @default("user")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  desc      String?
  type      String   @default("info")
  isNew     Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isNew])
  @@index([userId, createdAt])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  name      String
  phone     String
  address   String
  city      String
  province  String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
  @@index([city])
  @@index([deletedAt])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([userId, createdAt])
}

model Inquiry {
  id          String   @id @default(cuid())
  userId      String?
  roomType    String
  budget      Decimal? @db.Decimal(10, 2)
  description String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

model Settings {
  id              String   @id @default("singleton")
  siteName        String   @default("Fahad Ali Interior")
  adminEmail      String?
  contactPhone    String?
  storeAddress    String?
  currency        String   @default("PKR")
  socialInstagram String?
  socialFacebook  String?
  socialWhatsapp  String?
  foundedYear     String?
  bankName        String?
  accountTitle    String?
  accountNumber   String?
  iban            String?
  jazzcashNumber  String?
  easypaisaNumber String?
  themeFontFamily String?  @default("Outfit")
  themeBgColor    String?  @default("#FAF7F2")
  themeSurfaceColor String? @default("#FFFFFF")
  themeBorderColor String?  @default("#EAE5DF")
  themeDarkColor   String?  @default("#1A1A1A")
  themeMutedColor  String?  @default("#8A8682")
  themeAccentColor String?  @default("#2C251F")
  visualizerHeading String? @default("Visualize in your space with 3D")
  visualizerSubheading String? @default("Try our 3D live room feature and see how our furniture looks in your space before you buy.")
  visualizerModelUrl  String? @default("https://modelviewer.dev/shared-assets/models/Astronaut.glb")
  visualizerPrice     String? @default("$1,499")
  visualizerTitle     String? @default("Premium Sofa")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  discount       Decimal      @db.Decimal(10, 2)
  minOrderAmount Decimal      @default(0) @db.Decimal(10, 2)
  maxUses        Int          @default(0)
  usedCount      Int          @default(0)
  expiresAt      DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  discountType   DiscountType @default(PERCENTAGE)
  deletedAt       DateTime?
  createdBy       String?
  updatedBy       String?

  @@index([code, isActive])
  @@index([expiresAt, isActive])
  @@index([deletedAt])
  @@index([createdBy])
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  image     String
  link      String?
  price     Decimal? @db.Decimal(10, 2)
  colors    String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@index([isActive, order])
  @@index([deletedAt])
  @@index([createdBy])
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  excerpt   String?
  image     String?
  author    String   @default("Admin")
  isActive  Boolean  @default(true)
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([slug])
  @@index([createdAt])
  @@index([isActive, createdAt])
  @@index([deletedAt])
}

model CustomerNote {
  id             String       @id @default(cuid())
  userId         String
  authorId       String
  text           String
  priority       NotePriority @default(NORMAL)
  reminderAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  author         User         @relation("NoteAuthor", fields: [authorId], references: [id])

  @@index([userId])
  @@index([authorId])
  @@index([priority])
  @@index([reminderAt])
  @@index([deletedAt])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  ip        String?
  userAgent String?
  device    String?
  location  String?
  success   Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([userId, success])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum CustomerSegment {
  VIP
  HIGH_VALUE
  REPEAT
  NEW
  INACTIVE
  AT_RISK
  BLOCKED
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

enum NotePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum UserRole {
  USER
  VENDOR
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  AWAITING_VERIFICATION
  REFUNDED
}

enum PaymentMethod {
  COD
  JAZZCASH
  EASYPAISA
  BANK
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  image       String?
  icon        String?
  items       String?
  isPromo     Boolean   @default(false)
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?
  products    Product[]

  @@index([isActive, order])
  @@index([deletedAt])
  @@index([createdBy])
}

model AiConversation {
  id            String         @id @default(cuid())
  userId        String?
  sessionId     String         @unique
  customerName  String?
  customerEmail String?
  customerPhone String?
  channel       String         @default("WEB_CHAT") // WEB_CHAT, WHATSAPP, EMAIL
  status        String         @default("ACTIVE")   // ACTIVE, ESCALATED, CLOSED
  messages      AiMessage[]
  roomAnalyses  RoomAnalysis[]
  quotes        Quote[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([sessionId])
  @@index([userId])
}

model AiMessage {
  id                  String         @id @default(cuid())
  conversationId      String
  sender              String         // USER, AI, HUMAN_AGENT
  content             String         @db.Text
  tokensUsed          Int?
  toolCalls           Json?
  recommendedProducts Json?
  metadata            Json?
  createdAt           DateTime       @default(now())

  conversation        AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId])
}

model VectorKnowledgeDocument {
  id           String    @id @default(cuid())
  title        String
  category     String    // CATALOG, MATERIAL_GUIDE, WARRANTY, POLICY, FAQ, MANUFACTURING, CUSTOM_ORDER_GUIDE
  content      String    @db.Text
  metadata     Json?
  isPublished  Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([category])
}

model RoomAnalysis {
  id                String         @id @default(cuid())
  conversationId    String
  imageUrl          String
  roomType          String         // Living Room, Bedroom, Dining Room, Executive Office
  lighting          String?        // Warm Ambient, Natural Sunlight, Soft Evening
  colorPalette      String[]       // Extracted colors
  detectedFurniture String[]       // Detected elements
  availableSpace    String?        // Space assessment
  recommendations   Json           // Curated furniture recommendations & design rationale
  createdAt         DateTime       @default(now())

  conversation      AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId])
}

model Quote {
  id             String         @id @default(uuid())
  quoteNumber    String         @unique
  conversationId String
  items          Json           // Items, materials, finishes, custom dimensions
  subtotal       Decimal        @db.Decimal(12, 2)
  discount       Decimal        @default(0.00) @db.Decimal(12, 2)
  tax            Decimal        @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal        @db.Decimal(12, 2)
  validUntil     DateTime
  pdfUrl         String?
  createdAt      DateTime       @default(now())

  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([quoteNumber])
}

model ChatSession {
  id           String               @id @default(cuid())
  sessionId    String               @unique
  userId       String?
  customerName String?
  city         String?
  status       String               @default("active") // active, escalated, completed
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  user         User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages     ChatMessage[]
  events       ChatAnalyticsEvent[]

  @@index([sessionId])
  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

model ChatMessage {
  id           String      @id @default(cuid())
  sessionId    String
  role         String      // user, assistant, system, tool
  content      String      @db.Text
  intent       String?     // CATALOG_SEARCH, CUSTOM_QUOTE, ROOM_ANALYSIS, HUMAN_ESCALATION, GENERAL_QUERY
  metadata     Json?       // products, quote, roomAnalysis, suggestedPrompts, whatsAppUrl
  tokensUsed   Int         @default(0)
  createdAt    DateTime    @default(now())
  chatSession  ChatSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@index([intent])
}

model ProductEmbedding {
  id        String   @id @default(cuid())
  productId String   @unique
  vector    Json     // Array of floats representing text-embedding vector
  modelName String   @default("text-embedding-3-small")
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model ChatAnalyticsEvent {
  id          String       @id @default(cuid())
  sessionId   String
  eventType   String       // SEARCH, QUOTE, ROOM_ANALYSIS, ESCALATION, CONVERSION, UNANSWERED
  query       String?
  details     Json?
  createdAt   DateTime     @default(now())
  chatSession ChatSession? @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)

  @@index([sessionId])
  @@index([eventType])
  @@index([createdAt])
}


