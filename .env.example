# =============================================
# Fahad Ali Interior — Frontend Environment Variables
# Copy to .env and fill ALL values before running
# Generate secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================

# ── Database (frontend Prisma — same DB as backend) ──
# ⚠️ NEVER commit real credentials. Use neon.tech or local postgres.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── NextAuth ──────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=GENERATE_32_BYTE_HEX_HERE
NEXTAUTH_URL=https://yourdomain.com

# ── Backend Connection ────────────────────────────────
ENTERPRISE_API_ORIGIN=https://api.yourdomain.com

# Must match BACKEND/.env INTERNAL_PROXY_KEY exactly
INTERNAL_PROXY_KEY=GENERATE_32_BYTE_HEX_HERE

# ── Upstash Redis (for edge rate limiting in middleware) ──
# Get from: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ── Google OAuth ──────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com
# 2. Create project → APIs & Services → Credentials → Create OAuth 2.0 Client
# 3. Authorized redirect URIs: https://yourdomain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Set to true ONLY after filling GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET above
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false

# ── Web Push Notifications (VAPID) ───────────────────────────
# Generate: node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(JSON.stringify(k))"
# Must match BACKEND VAPID_PUBLIC_KEY
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
NEXT_PUBLIC_BACKEND_URL=https://api.yourdomain.com

# ── Email Verification ────────────────────────────────
# IMPORTANT: Keep false in production — requires email verification on login
SKIP_EMAIL_VERIFICATION=false

# ── Admin Seed ────────────────────────────────────────
# Used only for seeding — NOT a production credential
SEED_ADMIN_PASSWORD=StrongUniquePassword123!

# ── Cloudinary (Image Upload) ──────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_UPLOAD_PRESET=your-cloudinary-upload-preset
CLOUDINARY_FOLDER=your-cloudinary-folder

