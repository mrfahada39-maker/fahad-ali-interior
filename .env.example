# ==============================================================================
# Fahad Ali Interior — Environment Variables Configuration
# Copy this file to .env and configure all variables before running the project.
# Generate 32-byte hex secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==============================================================================

# ── 1. Database (PostgreSQL via Neon Serverless) ──────────────────────────────
DATABASE_URL="postgresql://user:password@ep-host-pooler.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"
DIRECT_DATABASE_URL="postgresql://user:password@ep-host.region.aws.neon.tech/neondb?sslmode=require"

# ── 2. NextAuth & Cryptographic Secrets ───────────────────────────────────────
# In production, each of these MUST be unique 32+ byte random hex strings.
NEXTAUTH_SECRET=GENERATE_32_BYTE_HEX_HERE
NEXTAUTH_URL=https://fahad-ali-interior.vercel.app
NEXT_PUBLIC_APP_URL=https://fahad-ali-interior.vercel.app
NEXT_PUBLIC_SITE_URL=https://fahad-ali-interior.vercel.app

# Dedicated isolated secrets (do NOT reuse NEXTAUTH_SECRET in production)
ADMIN_TOKEN_SECRET=GENERATE_SEPARATE_32_BYTE_HEX_FOR_ADMIN_TOKENS
TOTP_ENC_KEY=GENERATE_SEPARATE_32_BYTE_HEX_FOR_TOTP_ENCRYPTION
AI_SESSION_SECRET=GENERATE_SEPARATE_32_BYTE_HEX_FOR_AI_SESSIONS

# ── 3. Administrative Privileges ──────────────────────────────────────────────
ADMIN_EMAILS=mrfahada39@gmail.com
SEED_ADMIN_PASSWORD=StrongUniquePassword123!
SKIP_EMAIL_VERIFICATION=false

# ── 4. Edge Rate Limiting & Distributed Cache (Upstash Redis) ─────────────────
# Create database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ── 5. AI Concierge & Multi-Provider LLMs ─────────────────────────────────────
# Priority 1: Groq Cloud (Recommended: Ultra-fast Llama-3.3-70B / 120B)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Priority 2: Google Gemini (Gemini 2.0 Flash / 1.5 Pro)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Priority 3: OpenAI (Optional fallback)
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# VIP WhatsApp Concierge direct line & Admin Notification Destination (Your SIM number)
WHATSAPP_NUM=+923207006110
ADMIN_WHATSAPP_NUMBER=+923207006110

# Meta WhatsApp Cloud API (Optional - Official WhatsApp Business API for interactive buttons)
# Get from https://developers.facebook.com -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-meta-system-user-access-token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=fahad_ali_whatsapp_verify_token_2026

# ── 6. Media & Cloud Storage (Cloudinary) ─────────────────────────────────────
# Sign up at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_UPLOAD_PRESET=your-preset-name
CLOUDINARY_FOLDER=fahad-ali-interior

# ── 7. SMTP Email Configuration (Nodemailer / Gmail App Password) ────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
SMTP_FROM="Fahad Ali Interior <your-email@gmail.com>"
EMAIL_FROM="Fahad Ali Interior <your-email@gmail.com>"

# ── 8. Google OAuth (Optional Social Sign-in) ─────────────────────────────────
# Setup at https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false

# ── 9. Web Push Notifications (VAPID) ─────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
ENTERPRISE_API_ORIGIN=https://fahad-ali-interior.vercel.app
INTERNAL_PROXY_KEY=GENERATE_32_BYTE_HEX_HERE
